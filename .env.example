# ============================================================================
# AIFU Learning Platform — environment template
# Copy to `.env` (git-ignored) and change EVERY value marked CHANGE_ME.
# These defaults are DEVELOPMENT-ONLY credentials. Never use them anywhere real.
# ============================================================================

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=dev

# ---------- PostgreSQL ----------
# NOTE: inside docker compose the host is the SERVICE NAME `postgres`, not localhost.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aifu_lms
DB_USERNAME=aifu_app
DB_PASSWORD=dev_only_app_password_change_me
# Restricted role used ONLY by the execution worker (see V014 migration)
DB_WORKER_USERNAME=aifu_execution_worker
DB_WORKER_PASSWORD=dev_only_worker_password_change_me
# Superuser for container bootstrap only
POSTGRES_PASSWORD=dev_only_postgres_password_change_me

# ---------- JWT ----------
# Must be >= 32 bytes of real entropy. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_dev_only_secret_at_least_32_bytes_long_0000000000
JWT_ISSUER=aifu-lms
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# ---------- Security ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=PT15M
# Sign-ins and token refreshes per minute from one address. A campus shares one address.
AUTH_RATE_LIMIT_PER_MINUTE=300

# ---------- File storage ----------
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/var/lib/aifu/storage
STORAGE_MAX_UPLOAD_BYTES=52428800
# Only needed when STORAGE_PROVIDER=s3 (MinIO in dev, S3-compatible in prod)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=aifu-lms
STORAGE_ACCESS_KEY=CHANGE_ME_dev_only
STORAGE_SECRET_KEY=CHANGE_ME_dev_only
STORAGE_REGION=us-east-1

# ---------- Code execution ----------
# judge0 | docker-run | noop
EXECUTION_ENGINE=judge0
EXECUTION_JUDGE0_URL=http://judge0-server:2358
EXECUTION_JUDGE0_TOKEN=
EXECUTION_WORKER_CONCURRENCY=2
EXECUTION_POLL_INTERVAL=PT1S
EXECUTION_DEFAULT_CPU_TIME_LIMIT_MS=5000
EXECUTION_DEFAULT_WALL_TIME_LIMIT_MS=10000
EXECUTION_DEFAULT_MEMORY_LIMIT_KB=262144
EXECUTION_MAX_OUTPUT_BYTES=65536
EXECUTION_MAX_SOURCE_BYTES=131072

# ---------- Judge0 own infrastructure (see docker/judge0/) ----------
JUDGE0_REDIS_PASSWORD=dev_only_redis_password_change_me
JUDGE0_POSTGRES_PASSWORD=dev_only_judge0_db_password_change_me

# ---------- Observability ----------
LOG_LEVEL=INFO
LOG_FORMAT=json
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
